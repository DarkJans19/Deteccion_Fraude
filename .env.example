# Copia este archivo a .env y completa los valores reales:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# El .env real NO se versiona (.gitignore). Nunca subas credenciales al repo.
# Los valores con espacios, #, $ o comillas deben ir entre comillas dobles.

# ---------------------------------------------------------------------------
# MongoDB Atlas (compose.yaml)
# ---------------------------------------------------------------------------
# URI de conexión. Si incluye usuario y contraseña, tiene prioridad sobre
# MONGODB_USERNAME y MONGODB_PASSWORD.
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/fraud_detection?retryWrites=true&w=majority
MONGODB_DATABASE=fraud_detection

# Solo se usan si la URI no trae credenciales. Define ambos o ninguno.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# ---------------------------------------------------------------------------
# MongoDB local con Docker (compose.local.yaml)
# ---------------------------------------------------------------------------
# LOCAL_MONGO_PASSWORD es obligatoria para compose.local.yaml: sin ella el
# stack no arranca. Solo se aplica al crear un volumen nuevo; si ya existe
# mongo_data y cambias la contraseña, actualízala también en MongoDB.
LOCAL_MONGO_USERNAME=fraud_app
LOCAL_MONGO_PASSWORD=cambia-esta-contrasena

# ---------------------------------------------------------------------------
# Servicios opcionales
# ---------------------------------------------------------------------------
# Sin clave, Safe Browsing queda deshabilitado y el análisis local continúa.
GOOGLE_SAFE_BROWSING_API_KEY=
# Sin token, el perfil telegram no se conecta.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Puertos y red (opcionales)
# ---------------------------------------------------------------------------
APP_PORT=8765
QR_PORT=8000
# ALLOWED_HOSTS=localhost:8765,127.0.0.1:8765
# FRONTEND_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
# Archivo alterno de credenciales para Compose:
# MONGODB_ENV_FILE=./.env

# ---------------------------------------------------------------------------
# Modelo local (opcional)
# ---------------------------------------------------------------------------
# MODEL_PATH=backend/models/qwen_bosa_antifraude.gguf
