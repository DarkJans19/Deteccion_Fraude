# Copia este archivo a .env y completa los valores reales:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
#
# El .env real NO se versiona (.gitignore). Nunca subas credenciales al repo.
# Los valores con espacios, #, $ o comillas deben ir entre comillas dobles.

# ---------------------------------------------------------------------------
# MongoDB Atlas (compose.yaml)
# ---------------------------------------------------------------------------
# URI de conexión. Si incluye usuario y contraseña, tiene prioridad sobre
# MONGODB_USERNAME y MONGODB_PASSWORD.
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/fraud_detection?retryWrites=true&w=majority
MONGODB_DATABASE=fraud_detection

# Solo se usan si la URI no trae credenciales. Define ambos o ninguno.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# ---------------------------------------------------------------------------
# MongoDB local con Docker (compose.local.yaml)
# ---------------------------------------------------------------------------
# LOCAL_MONGO_PASSWORD es obligatoria para compose.local.yaml: sin ella el
# stack no arranca. Solo se aplica al crear un volumen nuevo; si ya existe
# mongo_data y cambias la contraseña, actualízala también en MongoDB.
LOCAL_MONGO_USERNAME=fraud_app
LOCAL_MONGO_PASSWORD=cambia-esta-contrasena

# ---------------------------------------------------------------------------
# Servicios opcionales
# ---------------------------------------------------------------------------
# Sin clave, Safe Browsing queda deshabilitado y el análisis local continúa.
GOOGLE_SAFE_BROWSING_API_KEY=
# En false, el análisis QR no solicita las URLs para seguir redirecciones.
QR_CHECK_REDIRECTS=true
# Sin token, el perfil telegram no se conecta.
TELEGRAM_BOT_TOKEN=
# API del modelo que usan los bots. Inicia antes la API:
#   uvicorn backend.api.main:app --host 127.0.0.1 --port 8000
ANALYSIS_API_URL=http://127.0.0.1:8000/api/analizar
# Tiempo máximo de espera del bot para cada análisis, en segundos.
# ANALYSIS_API_TIMEOUT=120

# ---------------------------------------------------------------------------
# Bot de WhatsApp (whatsapp-web.js)
# ---------------------------------------------------------------------------
# El bot deriva /api/analizar-imagen desde ANALYSIS_API_URL. Puedes sobrescribir
# cada endpoint por separado:
# WHATSAPP_ANALYSIS_API_URL=http://127.0.0.1:8000/api/analizar
# WHATSAPP_IMAGE_API_URL=http://127.0.0.1:8000/api/analizar-imagen
# Nombre de la sesión guardada en backend/whatsapp_bot/.wwebjs_auth
# WHATSAPP_SESSION_NAME=fraude-bot
# Vincular sin QR usando un código de 8 caracteres. Número internacional sin
# símbolos, por ejemplo 573001234567. Sigue siendo WhatsApp Web no oficial.
# WHATSAPP_PAIRING_PHONE=
# false = solo responde en chats privados.
# WHATSAPP_GROUPS_ENABLED=false
# Prefijo para activar el bot en grupos (además de mencionarlo).
# WHATSAPP_GROUP_TRIGGER=!analizar
# Lista blanca opcional separada por comas: 573001234567,573007654321
# WHATSAPP_ALLOWED_CHATS=
# WHATSAPP_MAX_MEDIA_MB=10
# WHATSAPP_MAX_TEXT_CHARS=50000
# WHATSAPP_COOLDOWN_SECONDS=3
# WHATSAPP_HEADLESS=true
# Ruta a Chrome/Chromium si Puppeteer no encuentra uno. En Docker se define
# automáticamente como /usr/bin/chromium.
# PUPPETEER_EXECUTABLE_PATH=

# ---------------------------------------------------------------------------
# OCR para imágenes (API /api/analizar-imagen)
# ---------------------------------------------------------------------------
# En Windows, si Tesseract no está en el PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANG=spa+eng
# IMAGE_MAX_MB=10

# ---------------------------------------------------------------------------
# Puertos y red (opcionales)
# ---------------------------------------------------------------------------
APP_PORT=8765
QR_PORT=8000
# ALLOWED_HOSTS=localhost:8765,127.0.0.1:8765
# FRONTEND_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
# Archivo alterno de credenciales para Compose:
# MONGODB_ENV_FILE=./.env

# ---------------------------------------------------------------------------
# Modelo local (opcional)
# ---------------------------------------------------------------------------
# MODEL_PATH=backend/models/qwen_bosa_antifraude.gguf
# TESSERACT_CMD=/usr/bin/tesseract
